{
  "name": "record-too-large-error",
  "request": {
    "method": "POST",
    "path": "/topics/orders",
    "headers": {
      "Content-Type": "application/vnd.kafka.json.v2+json",
      "Accept": "application/vnd.kafka.v2+json"
    },
    "body": {
      "records": [
        {
          "value": {
            "payload": "large"
          }
        }
      ]
    }
  },
  "producer_results": [
    {
      "error_code": 50002,
      "error": "The message is 2097254 bytes when serialized which is larger than 1048576, which is the value of the max.request.size configuration."
    }
  ],
  "expect": {
    "status": 200,
    "content_type": "application/vnd.kafka.v2+json",
    "body": {
      "offsets": [
        {
          "partition": null,
          "offset": null,
          "error_code": 50002,
          "error": "The message is 2097254 bytes when serialized which is larger than 1048576, which is the value of the max.request.size configuration."
        }
      ],
      "key_schema_id": null,
      "value_schema_id": null
    }
  }
}
