{
  "name": "bad-accept",
  "request": {
    "method": "POST",
    "path": "/topics/orders",
    "headers": {
      "Content-Type": "application/vnd.kafka.json.v2+json",
      "Accept": "application/xml"
    },
    "body": {
      "records": [
        {
          "value": {
            "ok": true
          }
        }
      ]
