# KafkaRestProxy-Go sample configuration.
# Keep secrets out of source control; use a platform secret manager for real deployments.

HTTP_ADDR=:8080
PPROF_ENABLE=false
HTTP_READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=20s
PRODUCE_TIMEOUT=30s

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kafka-rest-proxy-go
KAFKA_REQUIRED_ACKS=all
KAFKA_COMPRESSION=lz4
KAFKA_LINGER=0ms
KAFKA_DELIVERY_TIMEOUT=30s
KAFKA_REQUEST_TIMEOUT=10s
KAFKA_BATCH_MAX_BYTES=1048576
KAFKA_MAX_BUFFERED_RECORDS=100000
KAFKA_MAX_BUFFERED_BYTES=134217728

REQUEST_MAX_BYTES=8388608
REQUEST_MAX_RECORDS=1000
REQUEST_MAX_RECORD_BYTES=1048576
REQUEST_MAX_KEY_BYTES=1048576
REQUEST_MAX_HEADERS=64
REQUEST_MAX_HEADER_BYTES=65536

# Optional producer API guardrails.
TOPIC_ALLOWLIST=
AUTH_BEARER_TOKENS=
RATE_LIMIT_REQUESTS_PER_SECOND=0
RATE_LIMIT_REQUESTS_BURST=0
RATE_LIMIT_BYTES_PER_SECOND=0
RATE_LIMIT_BYTES_BURST=0

# Optional Kafka TLS and SASL settings.
KAFKA_TLS_ENABLE=false
KAFKA_TLS_INSECURE_SKIP_VERIFY=false
KAFKA_TLS_CA_FILE=
KAFKA_TLS_CERT_FILE=
KAFKA_TLS_KEY_FILE=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
